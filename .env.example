# Public site URL & optional external film override
NEXT_PUBLIC_SITE_URL=https://yuevaantravels.bt
NEXT_PUBLIC_FILM_URL=

# Server settings (npm start)
PORT=8081
# Optional dedicated port for the standalone Admin Portal (opens straight to /admin)
ADMIN_PORT=8082
INQUIRIES_DIR=./.data
TRUST_PROXY=

# PostgreSQL Database (Neon, Supabase, Railway, or local Postgres)
# Example: postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require
# Leave blank to run on the built-in local .data/ fallback store during development
DATABASE_URL=
# Set to "false" for local PostgreSQL without SSL; leave blank to auto-detect cloud SSL
DATABASE_SSL=

# Optional Slack / Zapier / Discord webhook for booking alerts
INQUIRY_WEBHOOK_URL=

# Admin Bookings Dashboard (/admin)
# Choose a strong password before deploying publicly
ADMIN_PASSWORD=
# Optional 32+ char secret for HMAC session cookies (auto-generated if omitted)
ADMIN_SESSION_SECRET=

# Automatic Email Notifications (supports Gmail SMTP OR Resend API)
# Where new booking & inquiry alerts should be delivered:
ADMIN_NOTIFICATION_EMAIL=
# Optional custom From header (defaults to SMTP_USER or Resend sender):
EMAIL_FROM=
# Send an automatic confirmation email to the guest too (1 = yes, 0 = admin only):
SEND_GUEST_CONFIRMATION=1

# Option A — Gmail SMTP (use a 16-character Google App Password, not your main password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Option B — Resend API (takes priority over SMTP if set; https://resend.com)
RESEND_API_KEY=
